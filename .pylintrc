[MASTER]
load-plugins=pylint_odoo

[ODOOLINT]
valid-odoo-versions=17.0
license-allowed=AGPL-3,LGPL-3,OPL-1
manifest-required-keys=license,version,author
manifest-deprecated-keys=description,active

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    duplicate-code,
    protected-access,
    consider-using-f-string

[FORMAT]
max-line-length=88

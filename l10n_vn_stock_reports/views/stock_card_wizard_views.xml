<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <record id="view_vn_stock_card_wizard_form" model="ir.ui.view">
        <field name="name">vn.stock.card.wizard.form</field>
        <field name="model">vn.stock.card.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory Report">
                <group>
                    <group name="period" string="Period">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group name="scope" string="Detail">
                        <field name="layout" widget="radio"/>
                    </group>
                </group>

                <group name="filters" string="Restrict to">
                    <field name="product_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="category_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>

                <div class="text-muted" colspan="2">
                    Quantities and values both come from the stock valuation
                    layers, so the closing value agrees with accounts 152, 155
                    and 156 by construction.
                </div>

                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_inventory_summary_wizard" model="ir.actions.act_window">
        <field name="name">Inventory Summary</field>
        <field name="res_model">vn.stock.card.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_stock_card_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_layout': 'summary'}</field>
    </record>

    <record id="action_vn_stock_card_wizard" model="ir.actions.act_window">
        <field name="name">Stock Card</field>
        <field name="res_model">vn.stock.card.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_stock_card_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_layout': 'card'}</field>
    </record>

    <record id="action_vn_stock_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Stock Ledger</field>
        <field name="res_model">vn.stock.card.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_stock_card_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_layout': 'ledger'}</field>
    </record>

</odoo>

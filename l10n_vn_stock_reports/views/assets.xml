<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!-- Odoo 14 has no manifest 'assets' key; backend assets are registered by
         inheriting web.assets_backend. The viewer JS itself lives in
         l10n_vn_vas_reports and needs no change to serve these reports. -->
    <template id="assets_backend" name="l10n_vn_stock_reports assets"
              inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/scss"
                  href="/l10n_vn_stock_reports/static/src/scss/vn_stock_report.scss"/>
        </xpath>
    </template>


    <!--
        Bản in dùng bundle khác hẳn màn hình: wkhtmltopdf nạp
        web.report_assets_common chứ không nạp web.assets_backend. Toàn bộ style
        bảng biểu vốn chỉ khai ở bundle backend đã **không hề có mặt** trên PDF —
        bảng mất viền, tiêu đề mất nền, khối điều kiện lọc dính liền thành một
        dòng chữ.

        Đăng ký cùng một tệp SCSS vào cả hai bundle, vì bản in và màn hình dùng
        chung một QWeb template; tách style làm hai thì hai bên sẽ trôi khỏi nhau.
        JavaScript thì không: bản in không có gì để tương tác.
    -->
    <template id="report_assets" name="l10n_vn_stock_reports report assets"
              inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/scss" href="/l10n_vn_stock_reports/static/src/scss/vn_stock_report.scss"/>
        </xpath>
    </template>
</odoo>

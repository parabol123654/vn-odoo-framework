              sequence="20"/>

    <menuitem id="menu_vn_report_sales_ledger"
              name="Sales Ledger (S35-DN)"
              parent="menu_vn_reports_detail"
              action="action_vn_sales_ledger_wizard"
              groups="l10n_vn_reports.group_vn_report_sales_ledger"
              sequence="15"/>

    <menuitem id="menu_vn_report_expense_ledger"
              name="Expense Ledger (S36-DN)"
              parent="menu_vn_reports_detail"
              action="action_vn_expense_ledger_wizard"
              groups="l10n_vn_reports.group_vn_report_expense_ledger"
              sequence="25"/>

    <menuitem id="menu_vn_report_material_allocation"
              name="Material Allocation (07-VT)"
              parent="menu_vn_reports_detail"

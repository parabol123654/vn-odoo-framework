<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!--
        Menu labels are English in source and Vietnamese through i18n/vi.po,
        which is the Odoo convention. Writing a Vietnamese source string here
        would leave an English user staring at "Sổ kế toán" next to "General
        Ledger" — and scripts/check_repo.py now refuses non-ASCII menu names
        for exactly that reason.

        The statutory headings printed *inside* the reports are a different
        matter: those are fixed by Thông tư 200 and are hardcoded in Vietnamese
        on purpose.

        Form numbers appear in the menu label because accountants look a report
        up by its number far more readily than by its name. Only reports that
        genuinely carry a number get one: the aged balances and the VAT listings
        are management reports and an annex respectively, and inventing a number
        for them would be worse than leaving it out. The numbers are checked
        against what each wizard declares, so the two cannot drift apart.
    -->

    <menuitem id="menu_vn_reports_root"
              name="Vietnam (VAS)"
              parent="account.menu_finance_reports"
              groups="l10n_vn_reports.group_vn_report_user"
              sequence="90"/>

    <!-- Sổ kế toán tổng hợp -->
    <menuitem id="menu_vn_reports_books"
              name="Accounting Books"
              parent="menu_vn_reports_root"
              sequence="10"/>

    <menuitem id="menu_vn_report_general_journal"
              name="General Journal (S03a-DN)"
              parent="menu_vn_reports_books"
              action="action_vn_general_journal_wizard"
              groups="l10n_vn_reports.group_vn_report_general_journal"
              sequence="10"/>

    <menuitem id="menu_vn_report_general_ledger"
              name="General Ledger (S03b-DN)"
              parent="menu_vn_reports_books"
              action="action_vn_general_ledger_wizard"
              groups="l10n_vn_reports.group_vn_report_general_ledger"
              sequence="20"/>

    <menuitem id="menu_vn_report_trial_balance"
              name="Trial Balance (S06-DN)"
              parent="menu_vn_reports_books"
              action="action_vn_trial_balance_wizard"
              groups="l10n_vn_reports.group_vn_report_trial_balance"
              sequence="30"/>

    <!-- Sổ chi tiết -->
    <menuitem id="menu_vn_reports_detail"
              name="Subsidiary Ledgers"
              parent="menu_vn_reports_root"
              sequence="20"/>

    <menuitem id="menu_vn_report_partner_ledger"

<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <record id="view_vn_aging_wizard_form" model="ir.ui.view">
        <field name="name">vn.aging.wizard.form</field>
        <field name="model">vn.aging.wizard</field>
        <field name="arch" type="xml">
            <form string="Aged Balance">
                <group>
                    <group name="period" string="As at">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_to" string="Balance as at"/>
                        <field name="target_move" widget="radio"/>
                        <!-- An aged balance has no start date; keep the mixin
                             field out of sight rather than let it mislead. -->
                        <field name="date_from" invisible="1"/>
                    </group>
                    <group name="scope" string="Scope">
                        <field name="aging_type" widget="radio"/>
                        <field name="basis" widget="radio"/>
                    </group>
                </group>

                <group name="filters" string="Restrict to">
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="account_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="journal_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>

                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Two entry points onto one wizard: the only difference is which side of
         the balance is reported, and that is a default, not a new model. -->
    <record id="action_vn_aged_receivable_wizard" model="ir.actions.act_window">
        <field name="name">Aged Receivable</field>
        <field name="res_model">vn.aging.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_aging_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_aging_type': 'receivable'}</field>
    </record>

    <record id="action_vn_aged_payable_wizard" model="ir.actions.act_window">
        <field name="name">Aged Payable</field>
        <field name="res_model">vn.aging.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_aging_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_aging_type': 'payable'}</field>
    </record>

</odoo>

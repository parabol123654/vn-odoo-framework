<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <record id="view_vn_production_cost_wizard_form" model="ir.ui.view">
        <field name="name">vn.production.cost.wizard.form</field>
        <field name="model">vn.production.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Production Cost">
                <group>
                    <group name="period" string="Period">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group name="scope" string="Detail">
                        <field name="layout" widget="radio"/>
                        <field name="include_open"/>
                    </group>
                </group>

                <group name="filters" string="Restrict to">
                    <field name="product_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="category_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>

                <div class="text-muted" colspan="2">
                    Direct materials only, taken from the valuation layers of the
                    components issued to each order, so the figures agree with
                    accounts 152 and 155. Direct labour and production overhead
                    are absent because Odoo 14 Community does not post them to
                    the ledger.
                </div>

                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_production_cost_wizard" model="ir.actions.act_window">
        <field name="name">Production Cost</field>
        <field name="res_model">vn.production.cost.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_production_cost_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_vn_cost_card_wizard" model="ir.actions.act_window">
        <field name="name">Cost Card</field>
        <field name="res_model">vn.production.cost.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_production_cost_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_layout': 'cost_card'}</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!--
        B02-DN. Every figure comes off the Financial Statement DTO; the template
        knows no account codes and performs no arithmetic. Indentation, bold and
        the "Thuyết minh" column are all mapping data.
    -->
    <!--
        Bảng chỉ tiêu dùng chung cho mọi báo cáo tài chính. Nhãn cột truyền vào
        bằng t-set trước khi t-call, vì B02-DN ghi "Năm nay / Năm trước" còn
        B01-DN ghi "Số cuối kỳ / Số đầu năm" — cùng một cấu trúc, khác cách gọi.
    -->
    <template id="statement_table">
        <table class="table table-sm o_vn_table o_vn_table_statement">
            <thead>
                <tr>
                    <th class="o_vn_col_label">CHỈ TIÊU</th>
                    <th class="o_vn_col_code">Mã số</th>
                    <th class="o_vn_col_code">Thuyết minh</th>
                    <th class="o_vn_col_amount">
                        <t t-esc="current_label or 'Năm nay'"/>
                    </th>
                    <th t-if="report.comparative" class="o_vn_col_amount">
                        <t t-esc="previous_label or 'Năm trước'"/>
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="report.lines" t-as="line">
                    <t t-set="can_drill"
                       t-value="interactive and drillable and line.account_ids"/>
                    <tr t-att-data-line-code="line.code if can_drill else None"
                        t-att-class="'o_vn_statement_line o_vn_bold' if line.bold else 'o_vn_statement_line'">
                    <td class="o_vn_col_label"
                        t-att-style="'padding-left: %spx' % (6 + 18 * line.level)">
                        <!-- Chỉ mở được những chỉ tiêu mà sổ cộng lại đúng bằng
                             con số vừa bấm. Tiêu đề và chỉ tiêu nhập tay không
                             có gì để mở. -->
                        <span t-if="can_drill" class="o_vn_drillable"
                              t-att-title="'Mở Sổ Cái của các tài khoản cấu thành chỉ tiêu %s' % line.code"
                              t-esc="line.name"/>
                        <span t-else="" t-esc="line.name"/>
                    </td>
                    <td class="o_vn_col_code" t-esc="line.code"/>
                    <td class="o_vn_col_code" t-esc="line.note_ref"/>
                    <td class="o_vn_col_amount" t-esc="line.amount"
                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    <td t-if="report.comparative" class="o_vn_col_amount"
                        t-esc="line.previous_amount or 0.0"
                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    </tr>
                </t>
            </tbody>
        </table>

        <div t-if="not report.lines" class="o_vn_empty">
            Ánh xạ báo cáo chưa có chỉ tiêu nào.
        </div>
    </template>

    <template id="income_statement_table">
        <t t-set="current_label" t-value="'Năm nay'"/>
        <t t-set="previous_label" t-value="'Năm trước'"/>
        <t t-set="drillable" t-value="True"/>
        <t t-call="l10n_vn_reports.statement_table"/>
    </template>

    <template id="income_statement_screen">
        <div class="o_vn_report o_vn_report_statement">
            <t t-call="l10n_vn_reports.vn_form_header"/>
            <t t-call="l10n_vn_reports.income_statement_table"/>
        </div>
    </template>

    <template id="report_income_statement">
        <t t-call="l10n_vn_reports.vn_print_layout">
                <div class="page o_vn_report o_vn_report_print">
                    <t t-call="l10n_vn_reports.vn_form_header"/>
                    <t t-call="l10n_vn_reports.income_statement_table"/>
                    <t t-call="l10n_vn_reports.vn_form_signature"/>
                </div>
        </t>
    </template>

</odoo>

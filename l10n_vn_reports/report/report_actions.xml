        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_reports.report_material_allocation</field>
        <field name="report_file">l10n_vn_reports.report_material_allocation</field>
        <field name="print_report_name">'Bang-phan-bo-NVL-CCDC-%s' % (object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_vn_book"/>
    </record>

    <record id="action_report_general_ledger" model="ir.actions.report">

    <record id="action_report_vat_declaration" model="ir.actions.report">
        <field name="name">VAT Declaration</field>
        <field name="model">vn.vat.declaration.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_reports.report_vat_declaration</field>
        <field name="report_file">l10n_vn_reports.report_vat_declaration</field>
        <field name="print_report_name">'To-khai-GTGT-%s' % (object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_vn_book"/>
    </record>

    <!--
        In từ chính bút toán, nên nó là báo cáo duy nhất ở đây có
        binding_model_id: kế toán mở phiếu quỹ ra và in ngay, không phải đi qua
        một wizard chọn kỳ.
    -->
    <record id="action_report_cash_voucher" model="ir.actions.report">
        <field name="name">Cash Voucher</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_reports.report_cash_voucher</field>
        <field name="report_file">l10n_vn_reports.report_cash_voucher</field>
        <field name="print_report_name">
            (object.vn_voucher_number or object.name).replace('/', '-')
        </field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>

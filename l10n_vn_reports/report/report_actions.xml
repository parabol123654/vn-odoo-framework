<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!-- Accounting books are wide; landscape with tight margins. -->
    <record id="paperformat_vn_book" model="report.paperformat">
        <field name="name">Vietnam Accounting Book (A4 landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">14</field>
        <!-- Chừa chỗ cho khối chân trang có số trang. -->
        <field name="margin_bottom">18</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_expense_ledger" model="ir.actions.report">
        <field name="name">Expense Ledger</field>
        <field name="model">vn.expense.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_reports.report_expense_ledger</field>
        <field name="report_file">l10n_vn_reports.report_expense_ledger</field>
        <field name="print_report_name">'So-chi-phi-SXKD-%s' % (object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_vn_book"/>
    </record>

    <record id="action_report_sales_ledger" model="ir.actions.report">
        <field name="name">Sales Ledger</field>
        <field name="model">vn.sales.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_reports.report_sales_ledger</field>
        <field name="report_file">l10n_vn_reports.report_sales_ledger</field>
        <field name="print_report_name">'So-chi-tiet-ban-hang-%s' % (object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_vn_book"/>
    </record>

    <record id="action_report_material_allocation" model="ir.actions.report">
        <field name="name">Material Allocation</field>

<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!--
        Statutory furniture shared by every VAS book. The headings here are
        fixed by Thông tư 200/2014/TT-BTC and are deliberately written in
        Vietnamese rather than passed through the translation system: this is
        the form a Vietnamese inspector expects to see, not a UI label.
    -->
    <template id="vn_form_header">
        <div class="o_vn_form_header">
            <div class="row">
                <div class="col-7">
                    <div>Đơn vị: <span t-field="company.name"/></div>
                    <div t-if="company.partner_id.contact_address">
                        Địa chỉ: <span t-esc="company.partner_id.contact_address.replace('\n', ' ').strip()"/>
                    </div>
                    <div t-if="company.vat">Mã số thuế: <span t-field="company.vat"/></div>
                </div>
                <!--
                    Only statutory books carry a form number. A management
                    report such as the aged balance has none, and printing
                    "Ban hành theo Thông tư 200" on it would claim an official
                    status it does not have.
                -->
                <div class="col-5 text-right o_vn_form_code" t-if="form_code">
                    <div>Mẫu số: <strong t-esc="form_code"/></div>
                    <div class="o_vn_form_legal">
                        (Ban hành theo Thông tư số 200/2014/TT-BTC<br/>
                        ngày 22/12/2014 của Bộ Tài chính)
                    </div>
                </div>
            </div>

            <h3 class="text-center o_vn_form_title" t-esc="form_title"/>
            <div class="text-center o_vn_form_period">
                Từ ngày <span t-field="doc.date_from"/>
                đến ngày <span t-field="doc.date_to"/>
            </div>
            <div class="text-center o_vn_form_unit">
                Đơn vị tiền tệ: <span t-field="currency.name"/>
            </div>

            <t t-call="l10n_vn_reports.vn_form_filters"/>
        </div>
    </template>

    <!--
        Điều kiện lọc đã áp dụng. Không phải trang trí: một bản in không ghi nó
        đang lọc theo tài khoản nào thì không kiểm toán được — tờ giấy trông y
        hệt nhau dù là toàn bộ sổ hay ba tài khoản chọn tay. Chỗ nào không lọc
        thì in "All", để việc không giới hạn được nói ra chứ không phải ngầm hiểu.
    -->
    <!--
        Layout in riêng, cố ý không gọi web.internal_layout.

        Layout chuẩn của Odoo tự phát ra một khối header mang tên công ty và
        ngày in. Trên biểu mẫu luật định, khối đó nằm đè lên phần "Đơn vị / Mã số
        thuế / Mẫu số" mà TT200 quy định, thành ra in hai lần hai kiểu. Tự dựng
        layout thì kiểm soát được chính xác cái gì lên giấy.

        Các span "page" và "topage" được wkhtmltopdf thay bằng số trang thật;
        chúng chỉ có tác dụng bên trong div.footer, nên khối này bắt buộc phải là
        anh em với div.article chứ không nằm trong đó.
    -->
    <template id="vn_print_layout">
        <t t-call="web.html_container">
            <div class="article o_vn_print_article"
                 t-att-data-oe-model="doc and doc._name or None"
                 t-att-data-oe-id="doc and doc.id or None">
                <t t-raw="0"/>
            </div>

            <div class="footer o_vn_print_footer">
                <div class="row">
                    <div class="col-8 text-left">
                        <span t-if="doc.create_uid">
                            Người in: <span t-field="doc.create_uid.name"/>
                        </span>
                        <span class="ml-3">
                            Ngày in: <span t-esc="context_timestamp(doc.create_date).strftime('%d/%m/%Y %H:%M')"/>
                        </span>
                    </div>
                    <div class="col-4 text-right">
                        Trang <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="vn_form_filters">
        <div t-if="filter_summary" class="o_vn_form_filters">
            <span t-foreach="filter_summary" t-as="row" class="o_vn_filter_item">
                <span class="o_vn_filter_label" t-esc="row[0]"/>:
                <span class="o_vn_filter_value" t-esc="row[1]"/>
            </span>
        </div>
    </template>

    <template id="vn_form_signature">
        <div class="row o_vn_signature">
            <div class="col-4 text-center">
                <div class="o_vn_signature_role">Người lập biểu</div>
                <div class="o_vn_signature_hint">(Ký, họ tên)</div>
            </div>
            <div class="col-4 text-center">
                <div class="o_vn_signature_role">Kế toán trưởng</div>
                <div class="o_vn_signature_hint">(Ký, họ tên)</div>
            </div>
            <div class="col-4 text-center">
                <div class="o_vn_signature_date">
                    Ngày <span t-esc="doc.date_to.day"/>
                    tháng <span t-esc="doc.date_to.month"/>
                    năm <span t-esc="doc.date_to.year"/>
                </div>
                <div class="o_vn_signature_role">Giám đốc</div>
                <div class="o_vn_signature_hint">(Ký, họ tên, đóng dấu)</div>
            </div>
        </div>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!--
        Tờ khai dùng lại statement_table: nó cũng là một danh sách chỉ tiêu có
        mã số, thứ bậc và dòng tổng in đậm. Khác duy nhất ở khối đối chiếu.

        Không bật drill-down: chỉ tiêu ở đây tổng hợp từ bảng kê hoá đơn chứ
        không từ số dư tài khoản, nên mở Sổ Cái sẽ ra con số khác.
    -->
    <template id="vat_declaration_reconciliation">
        <div t-if="report.balance_check and not report.balance_check.is_balanced"
             class="o_vn_alert o_vn_alert_error">
            <strong>Tờ khai chưa khớp với sổ kế toán.</strong>
            Chỉ tiêu 28 (thuế GTGT đầu ra theo bảng kê) =
            <span t-esc="report.balance_check.left_amount"
                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>,
            trong khi phát sinh Có tài khoản thuế GTGT đầu ra =
            <span t-esc="report.balance_check.right_amount"
                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>,
            lệch
            <strong><span t-esc="report.balance_check.difference"
                          t-options="{'widget': 'monetary', 'display_currency': currency}"/></strong>.
            Nguyên nhân thường gặp: có bút toán ghi thẳng vào tài khoản thuế mà
            không qua hoá đơn, nên không sinh dòng thuế và không lên bảng kê.
            Kiểm tra Sổ Cái tài khoản 3331 trong kỳ.
        </div>

        <div t-if="report.balance_check and report.balance_check.is_balanced"
             class="o_vn_alert o_vn_alert_ok">
            Đã khớp: thuế GTGT đầu ra trên tờ khai bằng phát sinh Có tài khoản
            thuế GTGT đầu ra trong kỳ.
        </div>

        <div class="o_vn_note">
            Các chỉ tiêu đánh dấu <em>(nhập tay)</em> không suy ra được từ sổ:
            chỉ tiêu 22 lấy từ chỉ tiêu 43 của kỳ trước, còn 37, 38 và 42 là
            quyết định của người khai. Tờ khai này chưa xử lý các chỉ tiêu
            32a, 39 và 40b.
        </div>
    </template>

    <template id="vat_declaration_screen">
        <div class="o_vn_report o_vn_report_statement">
            <t t-call="l10n_vn_reports.vn_form_header"/>
            <t t-set="current_label" t-value="'Số tiền'"/>
            <t t-set="previous_label" t-value="''"/>
            <t t-set="drillable" t-value="False"/>
            <t t-call="l10n_vn_reports.statement_table"/>
            <t t-call="l10n_vn_reports.vat_declaration_reconciliation"/>
        </div>
    </template>

    <template id="report_vat_declaration">
        <t t-call="l10n_vn_reports.vn_print_layout">
            <div class="page o_vn_report o_vn_report_print">
                <t t-call="l10n_vn_reports.vn_form_header"/>
                <t t-set="current_label" t-value="'Số tiền'"/>
                <t t-set="previous_label" t-value="''"/>
                <t t-set="drillable" t-value="False"/>
                <t t-call="l10n_vn_reports.statement_table"/>
                <t t-call="l10n_vn_reports.vat_declaration_reconciliation"/>
                <t t-call="l10n_vn_reports.vn_form_signature"/>
            </div>
        </t>
    </template>

</odoo>

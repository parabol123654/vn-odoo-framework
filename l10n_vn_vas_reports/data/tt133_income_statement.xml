<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 19.0 Community Edition -->
<odoo>
    <!--
        Mẫu B02-DNN — Báo cáo kết quả hoạt động kinh doanh (Thông tư 133/2016,
        Điều 81 mục 2.3 và Phụ lục 2).

        * 01 là lũy kế phát sinh **Có** TK 511, 02 là phát sinh **Nợ** TK 511 (đối ứng
          111, 112, 131): TT133 không có TK 521, giảm trừ doanh thu ghi thẳng Nợ 511.
        * Bút toán kết chuyển cuối kỳ (911, hoặc thẳng 421) không phải doanh thu hay
          chi phí, nên bị loại (closing_expression). Không loại thì mọi chỉ tiêu về 0
          ở kỳ đã khoá sổ.
        * 23 (chi phí lãi vay) là "số liệu chi tiết về lãi vay trên TK 635". TK 635
          không có tài khoản cấp 2 trong Phụ lục 1, nên để trống: công ty mở tài khoản
          con cho lãi vay rồi điền biểu thức.
        * TT133 gộp chi phí bán hàng và quản lý thành mã 24 (6421, 6422; giữ 641 cho
          chart kiểu TT200).
        * 31, 32 chưa bù trừ riêng lãi/lỗ thanh lý TSCĐ như luật hướng dẫn.
    -->
    <data noupdate="1">

        <record id="mapping_tt133_b02dnn" model="vn.report.mapping">
            <field name="code">tt133_b02dnn</field>
            <field name="name">Báo cáo kết quả hoạt động kinh doanh</field>
            <field name="report_type">income_statement</field>
            <field name="basis">movement</field>
            <field name="version">TT133</field>
            <field name="closing_expression">911*,421*</field>
            <field name="form_code">B02-DNN</field>
            <field name="form_title">BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH</field>
        </record>

        <record id="b02dnn_01" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">10</field><field name="code">01</field>
            <field name="name">1. Doanh thu bán hàng và cung cấp dịch vụ</field>
            <field name="expression">511*</field>
            <field name="sign">-1</field><field name="movement_side">credit</field>
            <field name="note_ref">VI.1</field>
        </record>
        <record id="b02dnn_02" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">20</field><field name="code">02</field>
            <field name="name">2. Các khoản giảm trừ doanh thu</field>
            <field name="expression">511*</field>
            <field name="movement_side">debit</field>
            <field name="note_ref">VI.2</field>
        </record>
        <record id="b02dnn_10" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">30</field><field name="code">10</field>
            <field name="name">3. Doanh thu thuần về bán hàng và cung cấp dịch vụ (10 = 01 - 02)</field>
            <field name="formula">01 - 02</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dnn_11" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">40</field><field name="code">11</field>
            <field name="name">4. Giá vốn hàng bán</field>
            <field name="expression">632*</field>
            <field name="note_ref">VI.3</field>
        </record>
        <record id="b02dnn_20" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">50</field><field name="code">20</field>
            <field name="name">5. Lợi nhuận gộp về bán hàng và cung cấp dịch vụ (20 = 10 - 11)</field>
            <field name="formula">10 - 11</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dnn_21" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">60</field><field name="code">21</field>
            <field name="name">6. Doanh thu hoạt động tài chính</field>
            <field name="expression">515*</field>
            <field name="sign">-1</field>
            <field name="note_ref">VI.4</field>
        </record>
        <record id="b02dnn_22" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">70</field><field name="code">22</field>
            <field name="name">7. Chi phí tài chính</field>
            <field name="expression">635*</field>
            <field name="note_ref">VI.5</field>
        </record>
        <record id="b02dnn_23" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">80</field><field name="code">23</field>
            <field name="name">- Trong đó: Chi phí lãi vay</field>
            <field name="level">1</field>
        </record>
        <record id="b02dnn_24" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">90</field><field name="code">24</field>
            <field name="name">8. Chi phí quản lý kinh doanh</field>
            <field name="expression">641*,642*</field>
            <field name="note_ref">VI.6</field>
        </record>
        <record id="b02dnn_30" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">100</field><field name="code">30</field>
            <field name="name">9. Lợi nhuận thuần từ hoạt động kinh doanh (30 = 20 + 21 - 22 - 24)</field>
            <field name="formula">20 + 21 - 22 - 24</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dnn_31" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">110</field><field name="code">31</field>
            <field name="name">10. Thu nhập khác</field>
            <field name="expression">711*</field>
            <field name="sign">-1</field>
            <field name="note_ref">VI.7</field>
        </record>
        <record id="b02dnn_32" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">120</field><field name="code">32</field>
            <field name="name">11. Chi phí khác</field>
            <field name="expression">811*</field>
            <field name="note_ref">VI.8</field>
        </record>
        <record id="b02dnn_40" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">130</field><field name="code">40</field>
            <field name="name">12. Lợi nhuận khác (40 = 31 - 32)</field>
            <field name="formula">31 - 32</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dnn_50" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">140</field><field name="code">50</field>
            <field name="name">13. Tổng lợi nhuận kế toán trước thuế (50 = 30 + 40)</field>
            <field name="formula">30 + 40</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dnn_51" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">150</field><field name="code">51</field>
            <field name="name">14. Chi phí thuế TNDN</field>
            <field name="expression">821*</field>
            <field name="note_ref">VI.9</field>
        </record>
        <record id="b02dnn_60" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt133_b02dnn"/>
            <field name="sequence">160</field><field name="code">60</field>
            <field name="name">15. Lợi nhuận sau thuế thu nhập doanh nghiệp (60 = 50 - 51)</field>
            <field name="formula">50 - 51</field>
            <field name="bold" eval="True"/>
        </record>

    </data>
</odoo>

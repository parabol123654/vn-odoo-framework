<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 15.0 Community Edition -->
<odoo>
    <!--
        Mẫu B02-DN — Báo cáo kết quả hoạt động kinh doanh (Thông tư
        200/2014/TT-BTC). Tên chỉ tiêu chép từ Phụ lục 2 mục 3 (Công báo
        289+290, tr. 54); nguồn số liệu theo Điều 113 khoản 3 (Công báo
        287+288, tr. 85-91).

        File này được sinh tự động; đừng sửa tay.

        noupdate="1": sửa ánh xạ mặc định phải đi kèm migration.

        * 01 là phát sinh Có TK 511; 02 là phát sinh Nợ TK 511 (Điều 113: đối
          ứng Có 521, tức sau khi kết chuyển 521 sang 511). 521 chưa kết chuyển
          không nằm ở 02 và hiện trong danh sách tài khoản chưa ánh xạ.
        * Bút toán kết chuyển (có TK 911, 421) bị loại (closing_expression).
          Các chỉ tiêu chi phí, thu nhập khác đọc phát sinh thuần trong kỳ,
          tương đương phát sinh kết chuyển sang 911 mà Điều 113 nêu.
        * Tài khoản ghi Có (doanh thu, thu nhập) dùng sign = -1 để in số dương.
        * 23 (chi phí lãi vay) theo sổ chi tiết TK 635; Phụ lục 1 không có tài
          khoản cấp 2 nên để trống: công ty khai báo tài khoản chi tiết lãi vay
          của mình (vd. 6351*) ở dòng này. 70, 71 (lãi trên cổ phiếu) để
          trống: cần số lượng cổ phiếu.
    -->
    <data noupdate="1">

        <record id="mapping_tt200_b02dn" model="vn.report.mapping">
            <field name="code">tt200_b02dn</field>
            <field name="name">Báo cáo kết quả hoạt động kinh doanh</field>
            <field name="report_type">income_statement</field>
            <field name="basis">movement</field>
            <field name="version">TT200</field>
            <field name="closing_expression">911*,421*</field>
            <field name="form_code">B02-DN</field>
            <field name="form_title">BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH</field>
        </record>

        <record id="b02dn_01" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">10</field>
            <field name="code">01</field>
            <field name="name">1. Doanh thu bán hàng và cung cấp dịch vụ</field>
            <field name="expression">511*</field>
            <field name="movement_side">credit</field>
            <field name="sign">-1</field>
            <field name="note_ref">VII.1</field>
        </record>

        <record id="b02dn_02" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">20</field>
            <field name="code">02</field>
            <field name="name">2. Các khoản giảm trừ doanh thu</field>
            <field name="expression">511*</field>
            <field name="movement_side">debit</field>
            <field name="note_ref">VII.2</field>
        </record>

        <record id="b02dn_10" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">30</field>
            <field name="code">10</field>
            <field name="name">3. Doanh thu thuần về bán hàng và cung cấp dịch vụ (10 = 01 - 02)</field>
            <field name="formula">01 - 02</field>
            <field name="bold" eval="True"/>
        </record>

        <record id="b02dn_11" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">40</field>
            <field name="code">11</field>
            <field name="name">4. Giá vốn hàng bán</field>
            <field name="expression">632*</field>
            <field name="note_ref">VII.3</field>
        </record>

        <record id="b02dn_20" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">50</field>
            <field name="code">20</field>
            <field name="name">5. Lợi nhuận gộp về bán hàng và cung cấp dịch vụ (20 = 10 - 11)</field>
            <field name="formula">10 - 11</field>
            <field name="bold" eval="True"/>
        </record>

        <record id="b02dn_21" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">60</field>
            <field name="code">21</field>
            <field name="name">6. Doanh thu hoạt động tài chính</field>
            <field name="expression">515*</field>
            <field name="sign">-1</field>
            <field name="note_ref">VII.4</field>
        </record>

        <record id="b02dn_22" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">70</field>
            <field name="code">22</field>
            <field name="name">7. Chi phí tài chính</field>
            <field name="expression">635*</field>
            <field name="note_ref">VII.5</field>
        </record>

        <record id="b02dn_23" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">80</field>
            <field name="code">23</field>
            <field name="name">- Trong đó: Chi phí lãi vay</field>
            <field name="level">1</field>
            <field name="note_ref">VII.5</field>
        </record>

        <record id="b02dn_25" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">90</field>
            <field name="code">25</field>
            <field name="name">8. Chi phí bán hàng</field>
            <field name="expression">641*</field>
            <field name="note_ref">VII.8</field>
        </record>

        <record id="b02dn_26" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">100</field>
            <field name="code">26</field>
            <field name="name">9. Chi phí quản lý doanh nghiệp</field>
            <field name="expression">642*</field>
            <field name="note_ref">VII.8</field>
        </record>

        <record id="b02dn_30" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">110</field>
            <field name="code">30</field>
            <field name="name">10. Lợi nhuận thuần từ hoạt động kinh doanh {30 = 20 + (21 - 22) - (25 + 26)}</field>
            <field name="formula">20 + 21 - 22 - 25 - 26</field>
            <field name="bold" eval="True"/>
        </record>

        <record id="b02dn_31" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">120</field>
            <field name="code">31</field>
            <field name="name">11. Thu nhập khác</field>
            <field name="expression">711*</field>
            <field name="sign">-1</field>
            <field name="note_ref">VII.6</field>
        </record>

        <record id="b02dn_32" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">130</field>
            <field name="code">32</field>
            <field name="name">12. Chi phí khác</field>
            <field name="expression">811*</field>
            <field name="note_ref">VII.7</field>
        </record>

        <record id="b02dn_40" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">140</field>
            <field name="code">40</field>
            <field name="name">13. Lợi nhuận khác (40 = 31 - 32)</field>
            <field name="formula">31 - 32</field>
            <field name="bold" eval="True"/>
        </record>

        <record id="b02dn_50" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">150</field>
            <field name="code">50</field>
            <field name="name">14. Tổng lợi nhuận kế toán trước thuế (50 = 30 + 40)</field>
            <field name="formula">30 + 40</field>
            <field name="bold" eval="True"/>
        </record>

        <record id="b02dn_51" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">160</field>
            <field name="code">51</field>
            <field name="name">15. Chi phí thuế TNDN hiện hành</field>
            <field name="expression">8211*</field>
            <field name="note_ref">VII.10</field>
        </record>

        <record id="b02dn_52" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">170</field>
            <field name="code">52</field>
            <field name="name">16. Chi phí thuế TNDN hoãn lại</field>
            <field name="expression">8212*</field>
            <field name="note_ref">VII.11</field>
        </record>

        <record id="b02dn_60" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">180</field>
            <field name="code">60</field>
            <field name="name">17. Lợi nhuận sau thuế thu nhập doanh nghiệp (60 = 50 - 51 - 52)</field>
            <field name="formula">50 - 51 - 52</field>
            <field name="bold" eval="True"/>
        </record>

        <record id="b02dn_70" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">190</field>
            <field name="code">70</field>
            <field name="name">18. Lãi cơ bản trên cổ phiếu (*)</field>
        </record>

        <record id="b02dn_71" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt200_b02dn"/>
            <field name="sequence">200</field>
            <field name="code">71</field>
            <field name="name">19. Lãi suy giảm trên cổ phiếu (*)</field>
        </record>

    </data>
</odoo>

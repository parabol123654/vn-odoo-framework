<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 16.0 Community Edition -->
<odoo>
    <!--
        Mẫu B02-DN — Báo cáo kết quả hoạt động kinh doanh (Thông tư 99/2025/TT-BTC,
        Phụ lục IV Mục 2 phần C).

        * 01 là phát sinh Có 511; 02 là phát sinh của 521 (TT99 có TK 521).
        * Bút toán kết chuyển (911, 421) bị loại, như B02 của TT200 và TT133.
        * 21 (lãi/lỗ thanh lý BĐSĐT), 24 (chi phí đi vay trong 635), 70, 71 (lãi trên
          cổ phiếu) để trống: cần chi tiết mà sổ cái không phân biệt được.
        * 31, 32 chưa bù trừ riêng lãi/lỗ thanh lý TSCĐ như văn bản hướng dẫn.
    -->
    <data noupdate="1">

        <record id="mapping_tt99_b02dn" model="vn.report.mapping">
            <field name="code">tt99_b02dn</field>
            <field name="name">Báo cáo kết quả hoạt động kinh doanh</field>
            <field name="report_type">income_statement</field>
            <field name="basis">movement</field>
            <field name="version">TT99</field>
            <field name="closing_expression">911*,421*</field>
            <field name="form_code">B02-DN</field>
            <field name="form_title">BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH</field>
        </record>

        <record id="b02dn99_01" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">10</field><field name="code">01</field>
            <field name="name">1. Doanh thu bán hàng và cung cấp dịch vụ</field>
            <field name="expression">511*</field>
            <field name="sign">-1</field><field name="movement_side">credit</field>
        </record>
        <record id="b02dn99_02" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">20</field><field name="code">02</field>
            <field name="name">2. Các khoản giảm trừ doanh thu</field>
            <field name="expression">521*</field>
        </record>
        <record id="b02dn99_10" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">30</field><field name="code">10</field>
            <field name="name">3. Doanh thu thuần về bán hàng và cung cấp dịch vụ (10 = 01 - 02)</field>
            <field name="formula">01 - 02</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dn99_11" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">40</field><field name="code">11</field>
            <field name="name">4. Giá vốn hàng bán</field>
            <field name="expression">632*</field>
        </record>
        <record id="b02dn99_20" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">50</field><field name="code">20</field>
            <field name="name">5. Lợi nhuận gộp về bán hàng và cung cấp dịch vụ (20 = 10 - 11)</field>
            <field name="formula">10 - 11</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dn99_21" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">60</field><field name="code">21</field>
            <field name="name">6. Lãi/lỗ của hoạt động bán, thanh lý bất động sản đầu tư</field>
        </record>
        <record id="b02dn99_22" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">70</field><field name="code">22</field>
            <field name="name">7. Doanh thu hoạt động tài chính</field>
            <field name="expression">515*</field>
            <field name="sign">-1</field>
        </record>
        <record id="b02dn99_23" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">80</field><field name="code">23</field>
            <field name="name">8. Chi phí tài chính</field>
            <field name="expression">635*</field>
        </record>
        <record id="b02dn99_24" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">90</field><field name="code">24</field>
            <field name="name">- Trong đó: Chi phí đi vay</field>
            <field name="level">1</field>
        </record>
        <record id="b02dn99_25" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">100</field><field name="code">25</field>
            <field name="name">9. Chi phí bán hàng</field>
            <field name="expression">641*</field>
        </record>
        <record id="b02dn99_26" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">110</field><field name="code">26</field>
            <field name="name">10. Chi phí quản lý doanh nghiệp</field>
            <field name="expression">642*</field>
        </record>
        <record id="b02dn99_30" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">120</field><field name="code">30</field>
            <field name="name">11. Lợi nhuận thuần từ hoạt động kinh doanh {30 = 20 + 21 + 22 - (23 + 25 + 26)}</field>
            <field name="formula">20 + 21 + 22 - 23 - 25 - 26</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dn99_31" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">130</field><field name="code">31</field>
            <field name="name">12. Thu nhập khác</field>
            <field name="expression">711*</field>
            <field name="sign">-1</field>
        </record>
        <record id="b02dn99_32" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">140</field><field name="code">32</field>
            <field name="name">13. Chi phí khác</field>
            <field name="expression">811*</field>
        </record>
        <record id="b02dn99_40" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">150</field><field name="code">40</field>
            <field name="name">14. Lợi nhuận khác (40 = 31 - 32)</field>
            <field name="formula">31 - 32</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dn99_50" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">160</field><field name="code">50</field>
            <field name="name">15. Tổng lợi nhuận kế toán trước thuế (50 = 30 + 40)</field>
            <field name="formula">30 + 40</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dn99_51" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">170</field><field name="code">51</field>
            <field name="name">16. Chi phí thuế TNDN hiện hành</field>
            <field name="expression">8211*</field>
        </record>
        <record id="b02dn99_52" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">180</field><field name="code">52</field>
            <field name="name">17. Chi phí thuế TNDN hoãn lại</field>
            <field name="expression">8212*</field>
        </record>
        <record id="b02dn99_60" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">190</field><field name="code">60</field>
            <field name="name">18. Lợi nhuận sau thuế thu nhập doanh nghiệp (60 = 50 - 51 - 52)</field>
            <field name="formula">50 - 51 - 52</field>
            <field name="bold" eval="True"/>
        </record>
        <record id="b02dn99_70" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">200</field><field name="code">70</field>
            <field name="name">19. Lãi cơ bản trên cổ phiếu (*)</field>
        </record>
        <record id="b02dn99_71" model="vn.report.mapping.line">
            <field name="mapping_id" ref="mapping_tt99_b02dn"/>
            <field name="sequence">210</field><field name="code">71</field>
            <field name="name">20. Lãi suy giảm trên cổ phiếu (*)</field>
        </record>

    </data>
</odoo>

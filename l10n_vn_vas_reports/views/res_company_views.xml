<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <!--
        Thông tư nào áp dụng là thuộc tính của công ty, không phải lựa chọn lúc
        chạy báo cáo. Đặt nó lên wizard sẽ mời người dùng lập báo cáo tài chính
        theo một thông tư khác với hệ thống tài khoản họ đang hạch toán.
    -->
    <record id="view_company_form_vn_circular" model="ir.ui.view">
        <field name="name">res.company.form.vn.circular</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="vn_accounting_circular"/>
            </xpath>
        </field>
    </record>

</odoo>

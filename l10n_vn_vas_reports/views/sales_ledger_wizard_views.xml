<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <record id="view_vn_sales_ledger_wizard_form" model="ir.ui.view">
        <field name="name">vn.sales.ledger.wizard.form</field>
        <field name="model">vn.sales.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Ledger">
                <group>
                    <group name="period" string="Period">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group name="scope" string="Scope">
                        <field name="target_move" widget="radio"/>
                    </group>
                </group>

                <group name="filters" string="Restrict to">
                    <field name="account_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="product_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="journal_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>

                <div class="text-muted" colspan="2">
                    Revenue per product from the 511 lines themselves,
                    deductions from 521, closing transfers excluded — so the
                    book adds up to account 511. VAT stays on the Bảng kê
                    01/GTGT, where the tax lines live.
                </div>

                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_sales_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Sales Ledger</field>
        <field name="res_model">vn.sales.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_sales_ledger_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>

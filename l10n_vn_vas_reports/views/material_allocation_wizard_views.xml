<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <record id="view_vn_material_allocation_wizard_form" model="ir.ui.view">
        <field name="name">vn.material.allocation.wizard.form</field>
        <field name="model">vn.material.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Material Allocation">
                <group>
                    <group name="period" string="Period">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group name="scope" string="Scope">
                        <field name="target_move" widget="radio"/>
                    </group>
                </group>

                <group name="filters" string="Restrict to">
                    <field name="account_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="journal_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>

                <div class="text-muted" colspan="2">
                    A period cross-tab: what left 152, 153 and 242, by the
                    account it was charged to. Built from the journal entries
                    themselves, so each column reconciles to that account's
                    credit total on the General Ledger.
                </div>

                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_material_allocation_wizard" model="ir.actions.act_window">
        <field name="name">Material Allocation</field>
        <field name="res_model">vn.material.allocation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_material_allocation_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>

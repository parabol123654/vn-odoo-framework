<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <record id="view_vn_vat_listing_wizard_form" model="ir.ui.view">
        <field name="name">vn.vat.listing.wizard.form</field>
        <field name="model">vn.vat.listing.wizard</field>
        <field name="arch" type="xml">
            <form string="VAT Invoice Listing">
                <group>
                    <group name="period" string="Period">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="target_move" widget="radio"/>
                    </group>
                    <group name="scope" string="Scope">
                        <field name="direction" widget="radio"/>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="journal_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_vat_sales_wizard" model="ir.actions.act_window">
        <field name="name">VAT Sales Listing</field>
        <field name="res_model">vn.vat.listing.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_vat_listing_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_direction': 'sale'}</field>
    </record>

    <record id="action_vn_vat_purchase_wizard" model="ir.actions.act_window">
        <field name="name">VAT Purchase Listing</field>
        <field name="res_model">vn.vat.listing.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_vat_listing_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_direction': 'purchase'}</field>
    </record>

</odoo>

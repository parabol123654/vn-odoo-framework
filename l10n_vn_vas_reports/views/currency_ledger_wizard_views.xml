<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 20.0 Community Edition -->
<odoo>

    <record id="view_vn_currency_ledger_wizard_form" model="ir.ui.view">
        <field name="name">vn.currency.ledger.wizard.form</field>
        <field name="model">vn.currency.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Foreign Currency Partner Ledger">
                <group>
                    <group name="period" string="Period">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="target_move" widget="radio"/>
                    </group>
                    <group name="scope" string="Scope">
                        <field name="foreign_currency_id"
                               options="{'no_create': True}"/>
                        <field name="partner_type" widget="radio"/>
                    </group>
                </group>

                <group name="filters" string="Restrict to">
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="account_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="journal_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>

                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_currency_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Foreign Currency Partner Ledger</field>
        <field name="res_model">vn.currency.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_currency_ledger_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>

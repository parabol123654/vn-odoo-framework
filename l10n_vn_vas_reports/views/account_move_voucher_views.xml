<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <record id="view_move_form_vn_voucher" model="ir.ui.view">
        <field name="name">account.move.form.vn.voucher</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Nút chỉ hiện khi bút toán thật sự là một phiếu quỹ, nên kế toán
                 không phải đoán chứng từ nào in được. -->
            <xpath expr="//header" position="inside">
                <button name="action_print_vn_voucher" type="object"
                        string="Print Cash Voucher" class="btn-secondary"
                        invisible="not vn_voucher_type"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="vn_voucher_type" invisible="1"/>
                <field name="vn_voucher_number" readonly="1"
                       invisible="not vn_voucher_number"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_vn_voucher" model="ir.ui.view">
        <field name="name">account.move.tree.vn.voucher</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="vn_voucher_number" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>

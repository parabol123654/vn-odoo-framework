<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <record id="view_vn_general_journal_wizard_form" model="ir.ui.view">
        <field name="name">vn.general.journal.wizard.form</field>
        <field name="model">vn.general.journal.wizard</field>
        <field name="arch" type="xml">
            <form string="General Journal">
                <group>
                    <group name="period" string="Period">
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="target_move" widget="radio"/>
                    </group>
                    <group name="filters" string="Restrict to">
                        <field name="journal_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <div class="text-muted" colspan="2">
                    The general journal is recorded in date order and is not
                    grouped by account, so this report offers no grouping option.
                </div>
                <footer>
                    <button name="action_view" type="object" string="View"
                            class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_general_journal_wizard" model="ir.actions.act_window">
        <field name="name">General Journal</field>
        <field name="res_model">vn.general.journal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vn_general_journal_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>

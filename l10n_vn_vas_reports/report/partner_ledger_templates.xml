<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!--
        No table of its own. The partner ledger is the same LedgerDTO as Sổ Cái,
        grouped by partner then account instead of by account, so it reuses
        ``general_ledger_table`` unchanged. Only the statutory header differs,
        and that already comes from the wizard through ``form_code`` and
        ``form_title``.

        This is the composition rule of Part 1 §5.6 in practice: a report is a
        way of displaying the engine's output, not a subclass of another report.
    -->
    <template id="partner_ledger_screen">
        <div class="o_vn_report o_vn_report_partner">
            <t t-call="l10n_vn_vas_reports.vn_form_header"/>
            <t t-call="l10n_vn_vas_reports.general_ledger_table"/>
        </div>
    </template>

    <template id="report_partner_ledger">
        <t t-call="l10n_vn_vas_reports.vn_print_layout">
                <div class="page o_vn_report o_vn_report_print">
                    <t t-call="l10n_vn_vas_reports.vn_form_header"/>
                    <t t-call="l10n_vn_vas_reports.general_ledger_table"/>
                    <t t-call="l10n_vn_vas_reports.vn_form_signature"/>
                </div>
        </t>
    </template>

</odoo>

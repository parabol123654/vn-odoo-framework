<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!--
        Bảng kê hoá đơn GTGT. One row per invoice per rate — never per journal
        item, which is why the Engine hands over rows already aggregated.
        Blocks are driven by report.groups, so adding a rate needs no template
        change.
    -->
    <template id="vat_listing_table">
        <table class="table table-sm o_vn_table o_vn_table_vat">
            <thead>
                <tr>
                    <th class="o_vn_col_seq">STT</th>
                    <th class="o_vn_col_ref">Số hoá đơn</th>
                    <th class="o_vn_col_date">Ngày</th>
                    <th class="o_vn_col_label">Tên người bán / người mua</th>
                    <th class="o_vn_col_vat">Mã số thuế</th>
                    <th class="o_vn_col_amount">Giá trị chưa thuế</th>
                    <th class="o_vn_col_amount">Tiền thuế</th>
                </tr>
            </thead>

            <tbody t-if="report.groups">
                <t t-foreach="report.groups" t-as="group">

                    <tr t-att-data-group="'g%s' % group_index"
                        t-att-data-group-key="group.rate"
                        t-att-class="'o_vn_group_row o_vn_group_toggle' if interactive else 'o_vn_group_row'">
                        <td colspan="5">
                            <span t-if="interactive" class="o_vn_caret fa fa-caret-down"/>
                            <strong t-esc="group.label"/>
                        </td>
                        <td class="o_vn_col_amount" t-esc="group.base_total"
                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        <td class="o_vn_col_amount" t-esc="group.tax_total"
                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    </tr>

                    <tr t-foreach="group.lines" t-as="line"
                        t-att-class="'o_vn_line o_vn_refund' if line.is_refund else 'o_vn_line'"
                        t-att-data-group-child="'g%s' % group_index"
                        t-att-data-move-id="line.move_id if interactive else None">
                        <td class="o_vn_col_seq" t-esc="line_index + 1"/>
                        <td class="o_vn_col_ref" t-esc="line.invoice_number"/>
                        <td class="o_vn_col_date" t-esc="line.invoice_date"
                            t-options="{'widget': 'date'}"/>
                        <td class="o_vn_col_label">
                            <span t-esc="line.partner_name"/>
                            <span t-if="line.is_refund" class="o_vn_muted">
                                (hoá đơn điều chỉnh)
                            </span>
                        </td>
                        <td class="o_vn_col_vat" t-esc="line.partner_vat"/>
                        <td class="o_vn_col_amount" t-esc="line.base_amount"
                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        <td class="o_vn_col_amount" t-esc="line.tax_amount"
                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    </tr>
                </t>
            </tbody>

            <tfoot t-if="report.groups">
                <tr class="o_vn_total_row">
                    <td colspan="5">
                        Tổng cộng
                        (<t t-esc="report.invoice_count"/> hoá đơn)
                    </td>
                    <td class="o_vn_col_amount" t-esc="report.base_total"
                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    <td class="o_vn_col_amount" t-esc="report.tax_total"
                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                </tr>
            </tfoot>
        </table>

        <div t-if="not report.groups" class="o_vn_empty">
            Không có hoá đơn nào trong kỳ đã chọn.
        </div>

        <div t-if="report.groups" class="o_vn_note">
            Số hoá đơn lấy từ trường <code>Ref</code> của chứng từ, nếu trống thì
            lấy số bút toán. Nếu hoá đơn điện tử lưu số ở trường khác, xem
            <code>OdooTaxRepository._invoice_number_column</code>.
        </div>
    </template>

    <template id="vat_listing_screen">
        <div class="o_vn_report o_vn_report_vat">
            <t t-call="l10n_vn_vas_reports.vn_form_header"/>
            <t t-call="l10n_vn_vas_reports.vat_listing_table"/>
        </div>
    </template>

    <template id="report_vat_listing">
        <t t-call="l10n_vn_vas_reports.vn_print_layout">
                <div class="page o_vn_report o_vn_report_print">
                    <t t-call="l10n_vn_vas_reports.vn_form_header"/>
                    <t t-call="l10n_vn_vas_reports.vat_listing_table"/>
                    <t t-call="l10n_vn_vas_reports.vn_form_signature"/>
                </div>
        </t>
    </template>

</odoo>

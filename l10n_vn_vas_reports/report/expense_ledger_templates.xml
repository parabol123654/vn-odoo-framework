<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <!--
        Sổ chi phí sản xuất, kinh doanh (S36-DN): sổ chi tiết bên Nợ của các
        tài khoản chi phí, kèm các cột "chia ra" theo khoản mục.

        Mỗi tài khoản là một bảng riêng chứ không phải một nhóm dòng trong một
        bảng chung, vì bộ cột "chia ra" của mỗi tài khoản một khác — TK 154
        chia theo 152/334/214, TK 642 chia theo 334/331/242 — và một ma trận
        chung cho tất cả sẽ toàn ô trống.

        Khoản mục là TK đối ứng cấp 1, do engine suy từ đúng cột "TK đối ứng"
        bên cạnh, nên hai cột không bao giờ mâu thuẫn. Dòng có nhiều TK đối
        ứng khác gốc không bị chẻ tiền theo phỏng đoán: nó nằm nguyên trong
        cột "Khác".
    -->
    <template id="expense_ledger_table">
        <t t-foreach="report.groups" t-as="group">
            <div class="o_vn_expense_group">
                <h4 class="o_vn_group_heading">
                    <strong t-out="group.display_name"/>
                </h4>
                <table class="table table-sm o_vn_table o_vn_table_ledger">
                    <thead>
                        <tr>
                            <th rowspan="2" class="o_vn_col_date">Ngày<br/>ghi sổ</th>
                            <th rowspan="2" class="o_vn_col_ref">Số hiệu<br/>chứng từ</th>
                            <th rowspan="2" class="o_vn_col_label">Diễn giải</th>
                            <th rowspan="2" class="o_vn_col_counterpart">TK<br/>đối ứng</th>
                            <th rowspan="2" class="o_vn_col_amount">Tổng số tiền<br/>(Nợ)</th>
                            <th t-if="group.columns" class="text-center"
                                t-att-colspan="str(len(group.columns))">Chia ra theo TK đối ứng</th>
                        </tr>
                        <tr>
                            <th t-foreach="group.columns" t-as="column"
                                class="o_vn_col_amount"
                                t-out="column or 'Khác'"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="o_vn_opening_row">
                            <td colspan="4">Số dư đầu kỳ</td>
                            <td class="o_vn_col_amount">
                                <span t-if="group.opening.debit_balance"
                                      t-out="group.opening.debit_balance"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                <span t-if="group.opening.credit_balance" class="o_vn_credit">
                                    (<span t-out="group.opening.credit_balance"
                                           t-options="{'widget': 'monetary', 'display_currency': currency}"/>)
                                </span>
                            </td>
                            <td t-foreach="group.columns" t-as="column"
                                class="o_vn_col_amount"/>
                        </tr>

                        <tr t-foreach="group.lines" t-as="line" class="o_vn_line"
                            t-att-data-search="line.move_name + ' ' + line.label"
                            t-att-data-move-id="line.move_id if interactive else None">
                            <td class="o_vn_col_date" t-out="line.date"
                                t-options="{'widget': 'date'}"/>
                            <td class="o_vn_col_ref" t-out="line.move_name"/>
                            <td class="o_vn_col_label" t-out="line.label"/>
                            <td class="o_vn_col_counterpart" t-out="line.counterpart_label"/>
                            <td class="o_vn_col_amount" t-out="line.debit"
                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            <td t-foreach="line.amounts" t-as="amount"
                                class="o_vn_col_amount">
                                <span t-if="amount" t-out="amount"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>

                        <tr class="o_vn_subtotal_row">
                            <td colspan="4">Cộng phát sinh trong kỳ</td>
                            <td class="o_vn_col_amount" t-out="group.debit_total"
                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            <td t-foreach="group.column_totals" t-as="total"
                                class="o_vn_col_amount">
                                <span t-if="total" t-out="total"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            </td>
                        </tr>

                        <tr class="o_vn_subtotal_row">
                            <td colspan="4">Ghi Có TK <t t-out="group.code"/></td>
                            <td class="o_vn_col_amount" t-out="group.credit_total"
                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            <td t-foreach="group.columns" t-as="column"
                                class="o_vn_col_amount"/>
                        </tr>

                        <tr class="o_vn_closing_row">
                            <td colspan="4">Số dư cuối kỳ</td>
                            <td class="o_vn_col_amount">
                                <span t-if="group.closing.debit_balance"
                                      t-out="group.closing.debit_balance"
                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                <span t-if="group.closing.credit_balance" class="o_vn_credit">
                                    (<span t-out="group.closing.credit_balance"
                                           t-options="{'widget': 'monetary', 'display_currency': currency}"/>)
                                </span>
                            </td>
                            <td t-foreach="group.columns" t-as="column"
                                class="o_vn_col_amount"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>

        <div t-if="not report.groups" class="o_vn_empty">
            Không có phát sinh nào trên các tài khoản đã chọn trong kỳ.
        </div>
    </template>

    <template id="expense_ledger_screen">
        <div class="o_vn_report o_vn_report_ledger">
            <t t-call="l10n_vn_vas_reports.vn_form_header"/>
            <t t-call="l10n_vn_vas_reports.expense_ledger_table"/>
        </div>
    </template>

    <template id="report_expense_ledger">
        <t t-call="l10n_vn_vas_reports.vn_print_layout">
                <div class="page o_vn_report o_vn_report_print">
                    <t t-call="l10n_vn_vas_reports.vn_form_header"/>
                    <t t-call="l10n_vn_vas_reports.expense_ledger_table"/>
                    <t t-call="l10n_vn_vas_reports.vn_form_signature"/>
                </div>
        </t>
    </template>

</odoo>

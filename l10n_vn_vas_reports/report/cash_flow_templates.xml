<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <!--
        B03-DN dùng lại statement_table cho phần chỉ tiêu; phần riêng là khối
        đối chiếu bên dưới.

        Khối đó quan trọng hơn ở bảng cân đối: tiền là con số duy nhất trên báo
        cáo tài chính đối chiếu được với một nguồn độc lập — sổ phụ ngân hàng và
        kiểm kê quỹ. Chỉ tiêu 70 lệch với số dư tiền thật thì chênh lệch chính
        bằng phần đã rơi mất.
    -->
    <template id="cash_flow_diagnostics">
        <div t-if="report.balance_check and not report.balance_check.is_balanced"
             class="o_vn_alert o_vn_alert_error">
            <strong>Báo cáo chưa khớp với số dư tiền.</strong>
            Chỉ tiêu 70 =
            <span t-out="report.balance_check.left_amount"
                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>,
            trong khi số dư thực tế của các tài khoản tiền =
            <span t-out="report.balance_check.right_amount"
                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>,
            lệch
            <strong><span t-out="report.balance_check.difference"
                          t-options="{'widget': 'monetary', 'display_currency': currency}"/></strong>.
            <t t-if="cash_flow_method == 'indirect'">
                Với phương pháp gián tiếp, nguyên nhân thường gặp là **sai dấu**
                ở một chỉ tiêu điều chỉnh vốn lưu động: phải thu tăng thì tiền
                giảm, nên chỉ tiêu đó phải mang dấu âm. Chênh lệch bằng đúng hai
                lần khoản bị đảo dấu.
            </t>
            <t t-else="">
                Chênh lệch này bằng đúng phần tiền đã dịch chuyển qua những tài
                khoản đối ứng liệt kê bên dưới.
            </t>
        </div>

        <div t-if="report.balance_check and report.balance_check.is_balanced"
             class="o_vn_alert o_vn_alert_ok">
            Đã khớp: chỉ tiêu 70 bằng số dư thực tế của các tài khoản tiền.
        </div>

        <div t-if="report.unmapped" class="o_vn_unmapped">
            <h5>
                <t t-if="cash_flow_method == 'indirect'">Tài khoản có số dư
                    nhưng chưa chỉ tiêu nào nhặt</t>
                <t t-else="">Tài khoản đối ứng làm dịch chuyển tiền nhưng chưa
                    được ánh xạ</t>
                (<t t-out="len(report.unmapped)"/>)</h5>
            <p class="o_vn_note">
                Bổ sung các tài khoản này vào chỉ tiêu phù hợp tại Kế toán →
                Cấu hình → Statement Mappings. Cột số dư là phần tiền vào (dương)
                hoặc ra (âm) mà chúng gây ra trong kỳ.
            </p>
            <table class="table table-sm o_vn_table">
                <thead>
                    <tr>
                        <th class="o_vn_col_code">Số hiệu TK</th>
                        <th class="o_vn_col_label">Tên tài khoản</th>
                        <th class="o_vn_col_amount">Tiền vào / ra</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="report.unmapped" t-as="account">
                        <td class="o_vn_col_code"><strong t-out="account.code"/></td>
                        <td class="o_vn_col_label" t-out="account.name"/>
                        <td class="o_vn_col_amount" t-out="account.balance"
                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="cash_flow_screen">
        <div class="o_vn_report o_vn_report_statement">
            <t t-call="l10n_vn_vas_reports.vn_form_header"/>
            <!--
                Cố ý không bật drill-down. Biểu thức của B03-DN chọn tài khoản
                **đối ứng** của các phát sinh tiền, nên mở Sổ Cái của chúng sẽ ra
                toàn bộ phát sinh của tài khoản đó, không riêng phần dính tới
                tiền — tổng sẽ không bằng con số vừa bấm. Một drill-down không
                cộng lại đúng thì tệ hơn là không có.
            -->
            <t t-set="current_label" t-value="'Kỳ này'"/>
            <t t-set="previous_label" t-value="'Kỳ trước'"/>
            <t t-set="drillable" t-value="False"/>
            <t t-call="l10n_vn_vas_reports.statement_table"/>
            <t t-call="l10n_vn_vas_reports.cash_flow_diagnostics"/>
        </div>
    </template>

    <template id="report_cash_flow">
        <t t-call="l10n_vn_vas_reports.vn_print_layout">
                <div class="page o_vn_report o_vn_report_print">
                    <t t-call="l10n_vn_vas_reports.vn_form_header"/>
                    <t t-set="current_label" t-value="'Kỳ này'"/>
                    <t t-set="previous_label" t-value="'Kỳ trước'"/>
                    <t t-set="drillable" t-value="False"/>
                    <t t-call="l10n_vn_vas_reports.statement_table"/>
                    <t t-call="l10n_vn_vas_reports.cash_flow_diagnostics"/>
                    <t t-call="l10n_vn_vas_reports.vn_form_signature"/>
                </div>
        </t>
    </template>

</odoo>

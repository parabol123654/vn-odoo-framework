<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo>

    <!--
        Bảng tổng hợp công nợ theo tuổi nợ.

        The columns are driven by report.buckets rather than hardcoded, so
        changing the ageing bands is a change in the Domain and this template
        follows without edit. Group keys are rendered as strings ("g0", "g1"),
        because QWeb drops a t-att-* whose value is falsy and the first group's
        index is 0.
    -->
    <template id="aging_table">
        <table class="table table-sm o_vn_table o_vn_table_aging">
            <thead>
                <tr>
                    <th class="o_vn_col_label">Đối tượng / Chứng từ</th>
                    <th class="o_vn_col_date">Ngày CT</th>
                    <th class="o_vn_col_date">Hạn thanh toán</th>
                    <th class="o_vn_col_days">Số ngày<br/>quá hạn</th>
                    <th class="o_vn_col_amount">Tổng nợ</th>
                    <th t-foreach="report.buckets" t-as="bucket"
                        class="o_vn_col_amount" t-esc="bucket.label"/>
                </tr>
            </thead>

            <tbody t-if="report.groups">
                <t t-foreach="report.groups" t-as="group">

                    <tr t-att-data-group="'g%s' % group_index"
                        t-att-data-group-key="group.partner_id or 0"
                        t-att-class="'o_vn_group_row o_vn_group_toggle' if interactive else 'o_vn_group_row'">
                        <td colspan="4">
                            <span t-if="interactive" class="o_vn_caret fa fa-caret-down"/>
                            <strong t-esc="group.partner_name or 'Không xác định'"/>
                        </td>
                        <td class="o_vn_col_amount" t-esc="group.total"
                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        <td t-foreach="group.amounts" t-as="amount"
                            class="o_vn_col_amount">
                            <span t-if="amount" t-esc="amount"
                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        </td>
                    </tr>

                    <tr t-foreach="group.lines" t-as="line"
                        class="o_vn_line"
                        t-att-data-group-child="'g%s' % group_index"
                        t-att-data-move-id="line.source.move_id if interactive else None">
                        <td class="o_vn_col_label">
                            <span t-esc="line.move_name"/>
                            <span t-if="line.label" class="o_vn_muted">
                                — <t t-esc="line.label"/>
                            </span>
                        </td>
                        <td class="o_vn_col_date" t-esc="line.date"
                            t-options="{'widget': 'date'}"/>
                        <td class="o_vn_col_date" t-esc="line.due_date"
                            t-options="{'widget': 'date'}"/>
                        <td class="o_vn_col_days">
                            <span t-if="line.days_overdue &gt; 0"
                                  class="o_vn_overdue" t-esc="line.days_overdue"/>
                        </td>
                        <td class="o_vn_col_amount" t-esc="line.residual"
                            t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        <!-- The residual is printed under its own ageing band
                             and left blank under every other. -->
                        <td t-foreach="report.buckets" t-as="bucket"
                            class="o_vn_col_amount">
                            <span t-if="bucket_index == line.bucket_index"
                                  t-esc="line.residual"
                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        </td>
                    </tr>
                </t>
            </tbody>

            <tfoot t-if="report.groups">
                <tr class="o_vn_total_row">
                    <td colspan="4">Tổng cộng</td>
                    <td class="o_vn_col_amount" t-esc="report.grand_total"
                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    <td t-foreach="report.totals" t-as="total"
                        class="o_vn_col_amount" t-esc="total"
                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                </tr>
            </tfoot>
        </table>

        <div t-if="not report.groups" class="o_vn_empty">
            Không còn công nợ nào chưa thanh toán tại ngày đã chọn.
        </div>
    </template>

    <template id="aging_screen">
        <div class="o_vn_report o_vn_report_aging">
            <t t-call="l10n_vn_vas_reports.vn_form_header"/>
            <t t-call="l10n_vn_vas_reports.aging_table"/>
        </div>
    </template>

    <template id="report_aging">
        <t t-call="l10n_vn_vas_reports.vn_print_layout">
                <div class="page o_vn_report o_vn_report_print">
                    <t t-call="l10n_vn_vas_reports.vn_form_header"/>
                    <t t-call="l10n_vn_vas_reports.aging_table"/>
                    <t t-call="l10n_vn_vas_reports.vn_form_signature"/>
                </div>
        </t>
    </template>

</odoo>

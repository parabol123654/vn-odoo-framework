<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 17.0 Community Edition -->
<odoo noupdate="1">

    <!--
        Multi-company rules for the notes to the financial statements (B09).
        Odoo 17 has no domain column on the access rights (that arrives with
        ir.access), so the company restriction the 20.0 branch writes into
        ir.access.csv lives here as global record rules. A user sees the notes
        of the companies currently selected, and the shared templates plus
        those of the selected companies.
    -->
    <record id="rule_vn_fs_note_company" model="ir.rule">
        <field name="name">Notes to the Financial Statements: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_item_company" model="ir.rule">
        <field name="name">Notes item: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note_item"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_row_company" model="ir.rule">
        <field name="name">Notes row: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note_row"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_check_company" model="ir.rule">
        <field name="name">Notes check: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note_check"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_template_company" model="ir.rule">
        <field name="name">Notes template: shared or own company</field>
        <field name="model_id" ref="model_vn_fs_note_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

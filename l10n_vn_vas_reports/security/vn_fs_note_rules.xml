<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 16.0 Community Edition -->
<odoo noupdate="1">

    <!--
        Notes to the financial statements (B09): a company's notes are seen
        only by users working in that company. 16.0 has no domain column on
        ir.model.access, so the company restriction lives here, as global
        rules (no groups): every access line granting these models carries
        the same domain on the 20.0 branch, so a global rule is equivalent.
    -->
    <record id="rule_vn_fs_note_company" model="ir.rule">
        <field name="name">Notes to the financial statements: own companies</field>
        <field name="model_id" ref="model_vn_fs_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_item_company" model="ir.rule">
        <field name="name">Notes items: own companies</field>
        <field name="model_id" ref="model_vn_fs_note_item"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_row_company" model="ir.rule">
        <field name="name">Notes rows: own companies</field>
        <field name="model_id" ref="model_vn_fs_note_row"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_check_company" model="ir.rule">
        <field name="name">Notes checks: own companies</field>
        <field name="model_id" ref="model_vn_fs_note_check"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_template_company" model="ir.rule">
        <field name="name">Notes templates: shared or own companies</field>
        <field name="model_id" ref="model_vn_fs_note_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_row_config_company" model="ir.rule">
        <field name="name">Notes row accounts: own companies</field>
        <field name="model_id" ref="model_vn_fs_note_row_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

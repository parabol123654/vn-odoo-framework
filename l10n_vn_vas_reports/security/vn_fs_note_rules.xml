<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 14.0 Community Edition -->
<odoo noupdate="1">

    <!--
        Multi-company rules for the notes to the financial statements (B09).
        20.0 puts these domains on ir.access; 14.0 has ir.model.access without
        domains, so they are record rules without groups (global) here. A
        company's notes, and everything inside them, are visible only within
        the companies the user has selected. Templates without a company are
        shared.
    -->
    <record id="rule_vn_fs_note_company" model="ir.rule">
        <field name="name">Notes to the Financial Statements: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_item_company" model="ir.rule">
        <field name="name">Notes to the Financial Statements, items: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note_item"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_row_company" model="ir.rule">
        <field name="name">Notes to the Financial Statements, rows: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note_row"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_check_company" model="ir.rule">
        <field name="name">Notes to the Financial Statements, checks: multi-company</field>
        <field name="model_id" ref="model_vn_fs_note_check"/>
        <field name="domain_force">[('note_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vn_fs_note_template_company" model="ir.rule">
        <field name="name">Notes Templates: shared or multi-company</field>
        <field name="model_id" ref="model_vn_fs_note_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

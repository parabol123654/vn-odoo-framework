<?xml version="1.0" encoding="UTF-8"?>
<!-- Target: Odoo 18.0 Community Edition — OWL template, loaded from the manifest assets -->
<templates id="template" xml:space="preserve">

    <t t-name="l10n_vn_vas_reports.ReportViewer">
        <div class="o_vn_viewer o_action">

            <div class="o_vn_toolbar">
                <div class="o_vn_toolbar_title">
                    <span class="o_vn_report_name" t-out="reportName"/>
                    <span class="o_vn_summary" t-out="state.summary"/>
                </div>

                <div class="o_vn_toolbar_actions" t-if="!state.failed">
                    <button type="button" class="btn btn-primary btn-sm o_vn_print_pdf"
                            t-on-click="onPrintPdf">
                        <i class="fa fa-file-pdf-o me-1"/>Print PDF
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm o_vn_export_xlsx"
                            t-on-click="onExportXlsx">
                        <i class="fa fa-file-excel-o me-1"/>Export Excel
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm o_vn_edit_filters"
                            t-on-click="onEditFilters">
                        <i class="fa fa-sliders me-1"/>Change period
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm o_vn_refresh"
                            t-on-click="onRefresh">
                        <i class="fa fa-refresh me-1"/>Refresh
                    </button>

                    <span class="o_vn_toolbar_divider"/>

                    <button type="button" class="btn btn-link btn-sm o_vn_expand_all"
                            t-on-click="onExpandAll">Expand all</button>
                    <button type="button" class="btn btn-link btn-sm o_vn_collapse_all"
                            t-on-click="onCollapseAll">Collapse all</button>

                    <div class="o_vn_search">
                        <i class="fa fa-search o_vn_search_icon"/>
                        <input type="text" class="form-control form-control-sm o_vn_search_input"
                               placeholder="Search in this report"
                               t-ref="search" t-on-input="onSearch"/>
                        <button type="button" class="btn btn-link btn-sm o_vn_search_clear"
                                title="Clear search" t-on-click="onSearchClear">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                </div>
            </div>

            <div class="o_vn_filter_notice alert alert-info" t-if="state.filtering">
                Showing matching lines only. The totals below still cover the whole period.
            </div>

            <div class="o_vn_expired" t-if="state.failed">
                <h4>This report is no longer available</h4>
                <p>
                    Report criteria are held temporarily and have since been cleared.
                    Open the report again from the Reporting menu to rebuild it.
                </p>
            </div>

            <div class="o_vn_report_content" t-if="!state.failed"
                 t-ref="content" t-on-click="onContentClick" t-out="state.html"/>
        </div>
    </t>

</templates>

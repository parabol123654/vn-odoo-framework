<?xml version="1.0" encoding="utf-8"?>
<!-- Target: Odoo 18.0 Community Edition -->
<odoo>

    <!--
        Demo data is generated in Python rather than declared as records here.
        Journal entries have to reference accounts of the installed chart, and
        those account XML IDs differ between l10n_vn, l10n_generic_coa and any
        customised chart. The generator resolves accounts by code prefix and
        creates what is missing, so this file works on any chart — and the exact
        same method is reachable from scripts/load_demo_data.py for databases
        that were created without demo data.
    -->
    <function model="vn.demo.data.generator" name="generate"/>

</odoo>

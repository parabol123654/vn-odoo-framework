msgid "Movement Side"
msgstr "Bên phát sinh"

#. module: vn_core
#: model:ir.model.fields.selection,name:vn_core.selection__vn_report_mapping_line__movement_side__net
msgid "Net movement"
msgstr "Phát sinh thuần"

#. module: vn_core
#: model:ir.model.fields,help:vn_core.field_vn_report_mapping__form_code
msgid "Printed top right of the statement, e.g. B01a-DNN. Leave empty to print the report's own default."
msgstr "In ở góc trên bên phải báo cáo, ví dụ B01a-DNN. Để trống để in mặc định của báo cáo."

#. module: vn_core
#: model:ir.model.fields.selection,name:vn_core.selection__vn_report_mapping_line__maturity__short
msgid "Short term"
msgstr "Ngắn hạn"

#. module: vn_core
#: model:ir.model.fields,help:vn_core.field_res_company__vn_balance_sheet_mapping_id
msgid "TT133 lets a company present B01b-DNN instead of B01a-DNN. Leave empty for the circular's default form."
msgstr "TT133 cho phép doanh nghiệp trình bày B01b-DNN thay cho B01a-DNN. Để trống để dùng mẫu mặc định của thông tư."

#. module: vn_core
#: model:ir.model.fields,help:vn_core.field_res_company__vn_cash_flow_mapping_id
msgid "The direct or the indirect method. Leave empty for the circular's default form."
msgstr "Phương pháp trực tiếp hoặc gián tiếp. Để trống để dùng mẫu mặc định của thông tư."

#. module: vn_core
#: model:ir.model.fields,help:vn_core.field_vn_report_mapping__sequence
msgid "When a circular offers several forms of one statement (B01a-DNN or B01b-DNN, the direct or the indirect cash flow), the lowest sequence is the default. A company picks another on its form."
msgstr "Khi thông tư có nhiều mẫu cho một báo cáo (B01a-DNN hoặc B01b-DNN, lưu chuyển tiền tệ trực tiếp hoặc gián tiếp), mẫu có thứ tự nhỏ nhất là mặc định. Công ty chọn mẫu khác trên form công ty."

#. module: vn_core

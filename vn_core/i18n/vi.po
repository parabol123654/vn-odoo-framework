#. module: vn_core
#: model:ir.model.fields,help:vn_core.field_vn_report_mapping_line__movement_side
msgid "For a statement of the period's movement: read the net change, or only the debits or the credits. B02-DNN item 01 is the credit movement of 511 and item 02 its debit movement."
msgstr "Với báo cáo phát sinh trong kỳ: đọc phát sinh thuần, hoặc chỉ phát sinh Nợ hay chỉ phát sinh Có. Chỉ tiêu 01 của B02-DNN là phát sinh Có TK 511, chỉ tiêu 02 là phát sinh Nợ."

#. module: vn_core
#: model:ir.model.fields,field_description:vn_core.field_vn_report_mapping__form_title
msgid "Form heading"
msgstr "Tiêu đề mẫu"

#. module: vn_core
#: model:ir.model.fields,field_description:vn_core.field_vn_report_mapping__form_code
msgid "Form number"
msgstr "Mẫu số"

#. module: vn_core
#: model:ir.model.fields.selection,name:vn_core.selection__vn_report_mapping_line__maturity__long
msgid "Long term"
msgstr "Dài hạn"

#. module: vn_core
#: model:ir.model.fields,field_description:vn_core.field_vn_report_mapping_line__maturity
msgid "Maturity"
msgstr "Kỳ hạn"

#. module: vn_core

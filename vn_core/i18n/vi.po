#. module: vn_core
#: model:ir.model.fields,help:vn_core.field_vn_report_mapping_line__sign
msgid ""
"Use -1 for accounts that carry a credit balance, such as revenue, so the "
"statement prints a positive figure."
msgstr "Dùng -1 cho tài khoản có số dư Có, như doanh thu, để báo cáo in ra số dương."

